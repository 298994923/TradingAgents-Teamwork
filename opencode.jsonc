{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules.md"],

  // OpenCode V1 policy (the installed opencode 1.18.29 rejects V2
  // "permissions"). Rules are object entries; the LAST matching pattern wins.
  // Read top-to-bottom: deny everything -> allow the workspace -> re-deny
  // protected/human-only paths -> allow a narrow shell surface.
  "permission": {
    "*": "deny",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      ".git/**": "deny"
    },

    "list": { "*": "allow" },
    "glob": { "*": "allow" },
    "grep": { "*": "ask" },

    "edit": {
      "*": "deny",
      "src/**": "allow",
      "test/**": "allow",
      "tests/**": "allow",
      "scripts/**": "allow",
      "docs/**": "allow",
      "prompts/**": "allow",
      "main.py": "allow",
      "pyproject.toml": "allow",
      "requirements.txt": "allow",
      "README.md": "allow",

      "tests/conftest.py": "deny",
      "tests/test_layering.py": "deny",
      "test/offline/conftest.py": "deny",
      "test/offline/test_ci_gates.py": "deny",
      "src/tradingagents/dataflows/**": "deny",
      "src/tradingagents/agents/structured.py": "deny",
      "src/tradingagents/agents/rating.py": "deny",
      "src/tradingagents/default_config.py": "deny",
      "docs/req/**": "deny",
      "docs/approvals/**": "deny",
      "docs/evaluation/test-baseline.json": "deny",
      "docs/code-governance/**": "deny",
      "scripts/ci_gates.py": "deny",
      "scripts/check_*.py": "deny",
      ".github/**": "deny",

      "AGENTS.md": "deny",
      "Prompt.md": "deny",
      "opencode.jsonc": "deny",
      ".opencode/**": "deny",
      ".agent/**": "deny",
      "docs/review-memo.md": "deny",
      "transcripts/**": "deny",

      "$HOME/.opencode/plan/*": "allow"
    },

    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch --show-current": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "python -m pytest *": "allow",
      "pytest *": "allow",
      "python -m ruff check *": "allow",
      "ruff check *": "allow",
      "python -m mypy *": "allow",
      "python -m compileall *": "allow",
      "python -m pip check *": "allow",
      "python scripts/check_secrets.py *": "allow",
      "python scripts/check_permission_sync.py *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "python --version": "allow",

      "rm *": "deny",
      "mv *": "deny",
      "cp *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "dd *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git clean *": "deny",
      "git commit *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git remote *": "deny",
      "git config *": "deny",
      "git add *": "deny",
      "git show *:.env*": "deny",
      "git log -p*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "pip install *": "deny",
      "pip uninstall *": "deny",
      "npm install *": "deny",
      "cat *": "deny",
      "head *": "deny",
      "tail *": "deny",
      "env *": "deny",
      "printenv *": "deny",
      "base64 *": "deny",
      "bash *": "deny",
      "sh *": "deny",
      "zsh *": "deny",
      "python -c *": "deny",
      "perl *": "deny",
      "ruby *": "deny",
      "node *": "deny",
      "find *": "deny",
      "xargs *": "deny",
      "sed *": "deny",
      "awk *": "deny",
      "ls ..*": "deny"
    },

    "external_directory": {
      "*": "deny",
      "$HOME/.opencode/plan/*": "allow"
    },

    "task": { "*": "deny" },
    "skill": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "ask",
    "lsp": "deny"
  }
}
